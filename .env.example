# ========================================================
# Summora AI - Environment Configuration Template
# Copy this file to .env and insert your actual credentials
# ========================================================

# Server Port (optional, defaults to 3000)
PORT=3000

# Google Gemini API Key (Required for AI analysis, questions, and chat)
# Obtain your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Optional - for user accounts and cloud note sync)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here